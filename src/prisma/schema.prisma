generator client {
  provider               = "prisma-client"
  output                 = "./generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  ORG_MANAGER
  COACH
  PLAYER
  REFEREE
  PUBLIC
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum TeamStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum TeamMemberRole {
  COACH
  PLAYER
}

enum CoachDegree {
  LEVEL_1
  LEVEL_2
  LEVEL_3
  NATIONAL
}

enum RefreeLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
  NATIONAL
}

model User {
  id           Int        @id @default(autoincrement())
  fullName     String     @map("full_name")
  phone        String     @unique
  email        String     @unique
  passwordHash String     @map("password_hash")
  avatarUrl    String?    @map("avatar_url")
  birthDate    DateTime?  @map("birth_date") @db.Date
  nationalId   String?    @unique @map("national_id")
  refreshToken String?    @map("refresh_token")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  roles        UserRole[]

  managedOrganizations OrganizationManager[]
  player               Player?
  coach                Coach?
  referee              Referee?
  teamMemberships      TeamSeasonMember[]

  @@map("users")
}

model UserRole {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  role   Role

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, role])
  @@map("user_roles")
}

model Organization {
  id          Int                @id @default(autoincrement())
  name        String
  logoUrl     String?            @map("logo_url")
  description String?            @db.Text
  city        String?
  phone       String?
  email       String?
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at")

  managers OrganizationManager[]
  teams    Team[]

  @@map("organizations")
}

model OrganizationManager {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  userId         Int      @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("organization_managers")
}

model Player {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  photoUrl  String?  @map("photo_url")
  height    Decimal? @db.Decimal(5, 2)
  position  String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("players")
}

model Coach {
  id        Int         @id @default(autoincrement())
  userId    Int         @unique @map("user_id")
  photoUrl  String?     @map("photo_url")
  degree    CoachDegree
  createdAt DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("coaches")
}

model Referee {
  id           Int         @id @default(autoincrement())
  userId       Int         @unique @map("user_id")
  licenseLevel RefreeLevel
  photoUrl     String?     @map("photo_url")
  createdAt    DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("referees")
}

model Team {
  id             Int        @id @default(autoincrement())
  organizationId Int        @map("organization_id")
  name           String
  logoUrl        String?    @map("logo_url")
  foundedDate    DateTime?  @map("founded_date") @db.Date
  status         TeamStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")

  organization Organization       @relation(fields: [organizationId], references: [id])
  members      TeamSeasonMember[]

  @@map("teams")
}

model Season {
  id        Int       @id @default(autoincrement())
  name      String
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  members TeamSeasonMember[]

  @@map("seasons")
}

model TeamSeasonMember {
  id           Int            @id @default(autoincrement())
  teamId       Int            @map("team_id")
  seasonId     Int            @map("season_id")
  userId       Int            @map("user_id")
  role         TeamMemberRole
  jerseyNumber Int?           @map("jersey_number")
  createdAt    DateTime       @default(now()) @map("created_at")

  team   Team   @relation(fields: [teamId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([teamId, seasonId, userId, role])
  @@unique([teamId, seasonId, jerseyNumber])
  @@map("team_season_members")
}
