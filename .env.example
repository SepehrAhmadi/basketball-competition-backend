# develop or production
NODE_ENV=develop

# server port
PORT=8081

# database info
DATABASE_USER="your_database_user"
DATABASE_PASSWORD="your_database_password"
DATABASE_NAME="readme_generator"
DATABASE_HOST="localhost"
DATABASE_PORT=3306

# run node in terminal and get the token with this command : require('crypto').randomBytes(64).toString('hex')
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

PROJECT_PATH_URL=https://yourprojectpathurl.com

# log level can choose between error, warn, info, http, debug , http
LOG_LEVEL=http
